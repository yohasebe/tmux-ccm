#!/usr/bin/env bash
# ccm - Claude Code Manager
# tmux window-based multi-project management tool for Claude Code

# Resolve symlinks and find the real directory of this script
_ccm_resolve() {
    local src="$1"
    while [[ -L "$src" ]]; do
        local dir
        dir=$(cd -P "$(dirname "$src")" && pwd)
        src=$(readlink "$src")
        [[ "$src" != /* ]] && src="$dir/$src"
    done
    cd -P "$(dirname "$src")" && pwd
}
CCM_ROOT="$(_ccm_resolve "$0")"

# Background commands must not fail on errors
case "${1:-}" in
    inject-status|clear-done|dashboard|dash|d|tree-interactive|ti|init) set +e ;;
    *) set -euo pipefail ;;
esac

# Source common library (init, hooks, deps, output helpers)
source "${CCM_ROOT}/lib/common.sh"

# Initialize runtime directories
ccm_init_dirs

ccm_usage() {
    cat <<'USAGE'
ccm - Claude Code Manager (window-based)

Usage:
  ccm add <dir> [name]              Add project as new window (name defaults to dir basename)
  ccm open <dir> [name]             Start claude in current pane for a project (split-pane use)
  ccm register <window> [name]      Register existing window as ccm project
  ccm unregister <name>             Unregister window from ccm (keep window alive)
  ccm rename <name> <new_name>      Rename a project
  ccm remove <name>                 Remove a project window (kill window)
  ccm attach <name|window_index>    Switch to a project window
  ccm list                          List managed project windows
  ccm status                        Show all projects with Claude state
  ccm tree                          Show session/window/pane hierarchy
  ccm capture [--copy] <name|window_index>  Capture project window (--copy: to clipboard)
  ccm ports                          Show listening ports per project
  ccm dashboard                     Open interactive dashboard (popup)
  ccm statusline                    One-line status (for tmux status bar)
  ccm snapshot save [name]          Save current projects as snapshot
  ccm snapshot load [name]          Load and restore a snapshot
  ccm snapshot list                 List available snapshots
  ccm snapshot delete [name]        Delete a snapshot
  ccm start [snapshot]              Start from a snapshot
  ccm stop [--all|name]             Stop project window(s)
  ccm menu                          Interactive menu (for keybinding)
  ccm pane-title [on|off|toggle|status]  Control pane title display
  ccm init                          Interactive setup wizard
  ccm setup-hooks                   Install Claude Code hooks for improved state detection
  ccm remove-hooks                  Remove ccm hooks from Claude Code settings
  ccm help                          Show this help
USAGE
}

# Main command dispatch
# Session/snapshot commands are handled by Python (lib/ccm_core.py).
# Only init, hooks, and deps remain in bash.
case "${1:-help}" in
    add)
        ccm_check_deps
        python3 "$CCM_ROOT/lib/ccm_core.py" add "${2:-}" "${3:-}"
        ;;
    open)
        python3 "$CCM_ROOT/lib/ccm_core.py" open "${2:-}" "${3:-}"
        ;;
    register|reg)
        python3 "$CCM_ROOT/lib/ccm_core.py" register "${2:-}" "${3:-}"
        ;;
    unregister|unreg)
        python3 "$CCM_ROOT/lib/ccm_core.py" unregister "${2:-}"
        ;;
    rename|mv)
        python3 "$CCM_ROOT/lib/ccm_core.py" rename "${2:-}" "${3:-}"
        ;;
    remove|rm)
        python3 "$CCM_ROOT/lib/ccm_core.py" remove "${2:-}"
        ;;
    attach|a)
        python3 "$CCM_ROOT/lib/ccm_core.py" attach "${2:-}"
        ;;
    list|ls)
        python3 "$CCM_ROOT/lib/ccm_core.py" list
        ;;
    status|st)
        python3 "$CCM_ROOT/lib/ccm_core.py" status
        ;;
    tree)
        python3 "$CCM_ROOT/lib/ccm_core.py" tree
        ;;
    tree-interactive|ti)
        python3 "$CCM_ROOT/lib/dashboard.py" --mode tree
        ;;
    ports)
        python3 "$CCM_ROOT/lib/ccm_core.py" ports
        ;;
    capture|cap)
        shift
        python3 "$CCM_ROOT/lib/ccm_core.py" capture "$@"
        ;;
    dashboard|dash|d)
        ccm_check_deps
        python3 "$CCM_ROOT/lib/dashboard.py"
        ;;
    statusline|sl)
        python3 "$CCM_ROOT/lib/ccm_core.py" statusline
        ;;
    inject-status)
        python3 "$CCM_ROOT/lib/inject_status.py" || true
        ;;
    clear-done)
        python3 "$CCM_ROOT/lib/ccm_core.py" clear-done || true
        ;;
    snapshot|snap)
        ccm_check_deps
        case "${2:-}" in
            save)  python3 "$CCM_ROOT/lib/ccm_core.py" snapshot-save "${3:-}" ;;
            load)  python3 "$CCM_ROOT/lib/ccm_core.py" snapshot-load "${3:-}" ;;
            list)  python3 "$CCM_ROOT/lib/ccm_core.py" snapshot-list ;;
            delete|del) python3 "$CCM_ROOT/lib/ccm_core.py" snapshot-delete "${3:-}" ;;
            *)     ccm_die "Usage: ccm snapshot save|load|list|delete [name]" ;;
        esac
        ;;
    start)
        ccm_check_deps
        if [[ -n "${2:-}" ]]; then
            python3 "$CCM_ROOT/lib/ccm_core.py" snapshot-load "$2"
        else
            ccm_die "Usage: ccm start <snapshot>"
        fi
        ;;
    stop)
        python3 "$CCM_ROOT/lib/ccm_core.py" stop "${2:-}"
        ;;
    menu)
        ccm_check_deps
        python3 "$CCM_ROOT/lib/dashboard.py" --mode menu
        ;;
    pane-title|pt)
        python3 "$CCM_ROOT/lib/ccm_core.py" pane-title "${2:-}"
        ;;
    init)
        ccm_init
        ;;
    setup-hooks)
        ccm_setup_hooks
        ;;
    remove-hooks)
        ccm_remove_hooks
        ;;
    help|--help|-h)
        ccm_usage
        ;;
    *)
        ccm_die "Unknown command: $1 (try 'ccm help')"
        ;;
esac
