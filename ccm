#!/usr/bin/env bash
# ccm - Claude Code Manager
# tmux window-based multi-project management tool for Claude Code

# Resolve symlinks and find the real directory of this script
_ccm_resolve() {
    local src="$1"
    while [[ -L "$src" ]]; do
        local dir
        [[ "$src" == */* ]] || src="./$src"
        dir=$(cd -P "${src%/*}" && pwd)
        src=$(readlink "$src")
        [[ "$src" != /* ]] && src="$dir/$src"
    done
    [[ "$src" == */* ]] || src="./$src"
    cd -P "${src%/*}" && pwd
}
CCM_ROOT="$(_ccm_resolve "$0")"

# Version of this ccm release. Keep in sync with CHANGELOG.md's
# top entry. Surfaced via `ccm --version` and `ccm version`.
CCM_VERSION="0.12.0"

# Background commands must not fail on errors
case "${1:-}" in
    inject-status|reset-window|dashboard|dash|d|search|tree-interactive|ti|init) set +e ;;
    *) set -euo pipefail ;;
esac

# The periodic status pass skips most seconds; decide that before
# reading the rest of ccm (see lib/ccm_reconcile_gate.sh).
# `--fast` is the hook-driven push and is never rate-limited.
if [[ "${1:-}" == "inject-status" && "$*" != *--fast* ]]; then
    source "${CCM_ROOT}/lib/ccm_tmp_root.sh"
    source "${CCM_ROOT}/lib/ccm_reconcile_gate.sh"
    _ccm_should_reconcile || exit 0
fi

# Source common library (init, hooks, deps, output helpers)
source "${CCM_ROOT}/lib/common.sh"


# Initialize runtime directories. The cache sweep is skipped on the
# hook-driven fast path: it fires on every state transition, and two
# find(1) walks per transition buy nothing the periodic poll's sweep
# does not.
ccm_init_dirs
ccm_resolve_python
if [[ "$*" != *--fast* ]]; then
    ccm_gc_tmp
fi

ccm_usage() {
    cat <<'USAGE'
ccm - Claude Code Manager (window-based)

Usage:
  ccm add <dir> [name]              Add project as new window (name defaults to dir basename)
  ccm open <dir> [name]             Start claude in current pane for a project (split-pane use)
  ccm register <window> [name]      Register existing window as ccm project
  ccm unregister <name>             Unregister window from ccm (keep window alive)
  ccm rename <name> <new_name>      Rename a project
  ccm remove <name>                 Remove a project window (kill window)
  ccm attach <name|window_index>    Switch to a project window
  ccm list                          List managed project windows
  ccm status                        Show all projects with Claude state
  ccm tree                          Show session/window/pane hierarchy
  ccm capture [--copy] <name|window_index>  Capture project window (--copy: to clipboard)
  ccm ports                          Show listening ports per project
  ccm dashboard [--search]          Open interactive dashboard (popup). --search jumps straight to live-filter search.
  ccm search                        Shorthand for `ccm dashboard --search`
  ccm statusline                    One-line status (for tmux status bar)
  ccm snapshot save [name]          Save current projects as snapshot
  ccm snapshot load [name]          Load and restore a snapshot
  ccm snapshot list                 List available snapshots
  ccm snapshot delete [name]        Delete a snapshot
  ccm roles [target] [--clear]      Inspect or release restored pane roles
  ccm prepare-logout [-y|--cancel]   Save and protect / unseal _autosave
  ccm start <snapshot>              Start from a snapshot
  ccm exit <name> [-y]             Exit Claude; keep window and sidekicks
  ccm stop [--all|name]             Stop project window(s)
  ccm bg list                       List external Claude Code agent-view sessions (read-only)
  ccm send <name> <msg> [flags]     Send a prompt to another project's Claude session
                                    flags: --file <path> | --stdin | - | --no-enter
                                           --force (BUSY) | --start (SHELL) | -y/--yes
                                           -- (end flags; for a msg starting with -)
  ccm sidekick-send <msg> [flags]   Send a prompt to the sidekick agent CLI in this window
                                    flags: --file <path> | --stdin | - | --no-enter | --
  ccm spool list|show|cancel|discard|resend|clear-expired|clear-held  Manage queued and undelivered messages
  ccm menu                          Interactive menu (for keybinding)
  ccm init                          Interactive setup wizard
  ccm setup-hooks                   Install Claude Code hooks for improved state detection
  ccm remove-hooks                  Remove ccm hooks from Claude Code settings
  ccm setup-claude-md               Add ccm section to ~/.claude/CLAUDE.md
  ccm remove-claude-md              Remove ccm section from ~/.claude/CLAUDE.md
  ccm debug trace <target> [interval]  Live state-detection trace; target is a project name or tmux pane/window (read-only)
  ccm errors [--clear]              View / clear the silent-exception log
  ccm reset <name>                  Clear stuck runtime state for a project (last-resort recovery)
  ccm doctor [--verbose]            Show issues; --verbose includes all diagnostic details
  ccm clear-notifications           Remove all ccm notifications from macOS Notification Center
  ccm help                          Show this help
  ccm version                       Print the ccm version
USAGE
}

# Main command dispatch
# Session/snapshot commands are handled by Python (lib/ccm_core.py).
# Only init, hooks, and deps remain in bash.
case "${1:-help}" in
    add)
        ccm_check_deps
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" add "${2:-}" "${3:-}"
        ;;
    open)
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" open "${2:-}" "${3:-}"
        ;;
    register|reg)
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" register "${2:-}" "${3:-}"
        ;;
    unregister|unreg)
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" unregister "${2:-}"
        ;;
    rename|mv)
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" rename "${2:-}" "${3:-}"
        ;;
    remove|rm)
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" remove "${2:-}"
        ;;
    attach|a)
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" attach "${2:-}"
        ;;
    list|ls)
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" list
        ;;
    status|st)
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" status
        ;;
    tree)
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" tree
        ;;
    tree-interactive|ti)
        "$CCM_PYTHON" "$CCM_ROOT/lib/dashboard.py" --mode tree
        ;;
    ports)
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" ports
        ;;
    capture|cap)
        shift
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" capture "$@"
        ;;
    dashboard|dash|d)
        ccm_check_deps
        shift
        "$CCM_PYTHON" "$CCM_ROOT/lib/dashboard.py" "$@"
        ;;
    search)
        # Shorthand: open the dashboard directly in search mode.
        ccm_check_deps
        "$CCM_PYTHON" "$CCM_ROOT/lib/dashboard.py" --search
        ;;
    statusline|sl)
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" statusline
        ;;
    inject-status)
        # Forward flags (e.g. --fast for the focus-refresh path).
        # Rate limiting for the periodic form happens before
        # `ccm_init_dirs` above — by the time dispatch runs, this
        # invocation has already earned its full pass.
        "$CCM_PYTHON" "$CCM_ROOT/lib/inject_status.py" "$@" || true
        ;;
    reset-window)
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" reset-window || true
        ;;
    dock)
        # Internal: the docked dashboard (key binding and window hooks).
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_dock.py" "${2:-toggle}" "${3:-}"
        ;;
    reset)
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" reset "${2:-}"
        ;;
    ignore)
        # `ccm ignore [project]` — hide a pane/project from ccm.
        # No arg = the current pane ($TMUX_PANE). Passes TMUX_PANE
        # through so the Python side can target the caller's pane.
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" ignore "${2:-}"
        ;;
    unignore)
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" unignore "${2:-}"
        ;;
    debug)
        # `ccm debug trace <target> [interval]` — live state-detection trace.
        # `target` is a project name or any tmux pane / window / session:index.
        shift
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" debug "$@"
        ;;
    errors)
        # `ccm errors [--clear]` — view / clear the silent-exception log.
        shift
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" errors "$@"
        ;;
    doctor)
        # `ccm doctor` — aggregate self-check.
        shift
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" doctor "$@"
        ;;
    clear-notifications)
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" clear-notifications
        ;;
    snapshot|snap)
        ccm_check_deps
        case "${2:-}" in
            save)  "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" snapshot-save "${3:-}" ;;
            load)  "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" snapshot-load "${3:-}" ;;
            list)  "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" snapshot-list ;;
            delete|del) "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" snapshot-delete "${3:-}" ;;
            *)     ccm_die "Usage: ccm snapshot save|load|list|delete [name]" ;;
        esac
        ;;
    bg)
        # Read-only view of Claude Code agent-view background
        # sessions (daemon-managed; out of ccm's control). Lifecycle
        # (dispatch / attach / stop) stays with `claude` itself.
        case "${2:-list}" in
            list|ls) "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" bg-list ;;
            *)       ccm_die "Usage: ccm bg list" ;;
        esac
        ;;
    roles)
        shift
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" roles "$@"
        ;;
    prepare-logout)
        shift
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" prepare-logout "$@"
        ;;
    start)
        ccm_check_deps
        if [[ -n "${2:-}" ]]; then
            "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" snapshot-load "$2"
        else
            ccm_die "Usage: ccm start <snapshot>"
        fi
        ;;
    exit)
        shift
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" exit "$@"
        ;;
    stop)
        # Forward all args (`--all` is a flag, not a name); the Python
        # side parses them via raw-argv passthrough like capture/send.
        shift
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" stop "$@"
        ;;
    send)
        shift
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" send "$@"
        ;;
    sidekick-send)
        # Raw-argv passthrough like send: the message is positional
        # and may start with a dash after `--`.
        shift
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" sidekick-send "$@"
        ;;
    spool)
        shift
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" spool "$@"
        ;;
    menu)
        ccm_check_deps
        "$CCM_PYTHON" "$CCM_ROOT/lib/dashboard.py" --mode menu
        ;;
    init)
        ccm_init
        ;;
    setup-hooks)
        ccm_setup_hooks
        ;;
    remove-hooks)
        ccm_remove_hooks
        ;;
    setup-sidekick-hooks)
        # Install ccm's attention adapter into a sidekick CLI's own
        # hook config (Kimi), so it self-reports "waiting on a
        # decision" — the ▸ badge turns PERMIT-yellow and a desktop
        # notification fires.
        shift
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" setup-sidekick-hooks "$@"
        ;;
    remove-sidekick-hooks)
        shift
        "$CCM_PYTHON" "$CCM_ROOT/lib/ccm_core.py" remove-sidekick-hooks "$@"
        ;;
    setup-claude-md)
        ccm_setup_claude_md
        ;;
    remove-claude-md)
        ccm_remove_claude_md
        ;;
    help|--help|-h)
        ccm_usage
        ;;
    version|--version|-v)
        echo "ccm ${CCM_VERSION}"
        ;;
    *)
        ccm_die "Unknown command: $1 (try 'ccm help')"
        ;;
esac
