#compdef ccm

_ccm() {
    local -a subcommands
    subcommands=(
        'add:Add project as new window'
        'open:Start claude in current pane'
        'register:Register existing window as ccm project'
        'unregister:Unregister window from ccm (keep window)'
        'rename:Rename a project'
        'remove:Remove a project window (kill window)'
        'attach:Switch to a project window'
        'list:List managed project windows'
        'status:Show all projects with Claude state'
        'tree:Show session/window/pane hierarchy'
        'tree-interactive:Interactive tree view (for keybinding)'
        'ports:Show listening ports per project'
        'capture:Capture project window visible content'
        'dashboard:Open interactive dashboard'
        'search:Open dashboard in live-filter search mode'
        'statusline:One-line status for tmux status bar'
        'snapshot:Snapshot operations'
        'start:Start from a snapshot'
        'stop:Stop project window(s)'
        'bg:External Claude Code agent-view sessions'
        'send:Send a prompt to another project'
        'sidekick-send:Send a prompt to the sidekick agent CLI in this window'
        'menu:Interactive menu'
        'init:Interactive setup wizard'
        'setup-hooks:Install Claude Code hooks for improved state detection'
        'remove-hooks:Remove ccm hooks from Claude Code settings'
        'setup-claude-md:Add ccm section to ~/.claude/CLAUDE.md'
        'remove-claude-md:Remove ccm section from ~/.claude/CLAUDE.md'
        'errors:View / clear the silent-exception log'
        'reset:Clear stuck runtime state for a project'
        'reset-window:Internal post-attach reset (not user-facing)'
        'ignore:Hide a pane/project from ccm'
        'unignore:Restore a hidden pane/project to ccm'
        'debug:Live state-detection trace (debug trace)'
        'doctor:Self-check: dependencies, hooks, canaries, projects'
        'clear-notifications:Remove all ccm notifications from Notification Center'
        'version:Print the ccm version'
        'help:Show help'
    )

    local -a projects
    _ccm_projects() {
        projects=(${(f)"$(ccm list 2>/dev/null | tail -n +3 | awk '{print $1}')"})
        [[ -n "$projects" ]] && compadd -a projects
    }

    local -a snapshots
    _ccm_snapshots() {
        local _snap_dir="${XDG_DATA_HOME:-$HOME/.local/share}/ccm/snapshots"
        # (N:t:r): null-glob, basename, strip .json — safe for names with spaces
        snapshots=( "$_snap_dir"/*.json(N:t:r) )
        [[ -n "$snapshots" ]] && compadd -a snapshots
    }

    if (( CURRENT == 2 )); then
        _describe 'ccm command' subcommands
    elif (( CURRENT == 3 )); then
        case "${words[2]}" in
            attach|a|unregister|unreg|remove|rm|rename|mv|capture|cap|stop|send|reset|ignore|unignore)
                _ccm_projects
                ;;
            add|open)
                _directories
                ;;
            register|reg)
                # Complete window names
                local -a windows
                windows=(${(f)"$(tmux list-windows -F '#{window_name}' 2>/dev/null)"})
                compadd -a windows
                ;;
            snapshot|snap)
                local -a snap_cmds
                snap_cmds=('save' 'load' 'list' 'delete')
                compadd -a snap_cmds
                ;;
            bg)
                local -a bg_cmds
                bg_cmds=('list')
                compadd -a bg_cmds
                ;;
            debug)
                local -a debug_cmds
                debug_cmds=('trace')
                compadd -a debug_cmds
                ;;
            start)
                _ccm_snapshots
                ;;
        esac
    elif (( CURRENT == 4 )); then
        case "${words[2]}" in
            snapshot|snap)
                case "${words[3]}" in
                    load|delete|del)
                        _ccm_snapshots
                        ;;
                esac
                ;;
            debug)
                case "${words[3]}" in
                    trace)
                        _ccm_projects
                        ;;
                esac
                ;;
        esac
    fi
}

_ccm "$@"
