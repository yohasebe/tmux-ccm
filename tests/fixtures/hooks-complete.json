    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/plugin/hooks/on-pre-tool-use.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/plugin/hooks/on-notification.sh"
          }
